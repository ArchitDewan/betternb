# Copy this file to .env.local and replace the Auth0 values once.
# .env.local is ignored by Git.

BETTERNB_DATABASE_URL=postgres://betternb:betternb@127.0.0.1:5432/betternb?sslmode=disable
BETTERNB_AUTH0_ISSUER=https://YOUR_TENANT.auth0.com/
BETTERNB_AUTH0_DOMAIN=YOUR_TENANT.auth0.com
BETTERNB_AUTH0_CLIENT_ID=YOUR_NATIVE_APP_CLIENT_ID
BETTERNB_AUTH0_AUDIENCE=https://api.betternb.com

# Required by the local tutoring service. Keep this value server-side.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
BETTERNB_OPENAI_MODEL=gpt-6.1-sol
BETTERNB_EMBEDDING_MODEL=text-embedding-3-small

# These development defaults normally do not need changing.
BETTERNB_API_ADDRESS=127.0.0.1:8081
BETTERNB_API_URL=http://127.0.0.1:8081
BETTERNB_TUTOR_ADDRESS=127.0.0.1
BETTERNB_TUTOR_PORT=8082
BETTERNB_TUTOR_URL=http://127.0.0.1:8082
